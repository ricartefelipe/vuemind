{
  "name": "vuemind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:pages": "VITE_BASE=/vuemind/ VITE_ENABLE_MSW=true vue-tsc -b && VITE_BASE=/vuemind/ VITE_ENABLE_MSW=true vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc -b --noEmit"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@ricartefelipe/mind-wallet-shared": "file:../mind-shared",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/vue": "^8.1.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "typescript": "~5.7.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "editorconfig": {
      "minimatch": "^11.0.4"
    },
    "js-beautify": {
      "glob": "^14.0.3"
    }
  }
}
